{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5434;Database=events;Username=postgres;Password=postgres"
  },
  "JWT": {
    "Key": "1234567890123456789012345678901234567890",
    "Issuer": "events-service",
    "Audience": "events-service-api",
    "ExpirationTimeMinutes": 30
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "GroupId": "bookings-processing"
  },
  "Redis": {
    "RedisServer": "localhost:6379",
    "EventsTtlSeconds": 30 
  },
  "AllowedHosts": "*"
}
